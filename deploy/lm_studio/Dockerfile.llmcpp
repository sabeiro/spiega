# GPU-enabled llm-studio on NVIDIA Jetson
FROM ghcr.io/ggml-org/llama.cpp:light-cuda

WORKDIR /app

# Install Python runtime with pip
RUN apt-get update && apt-get install -y  python3 python3-pip python3-dev  build-essential && rm -rf /var/lib/apt/lists/*

# Install pip if not available in base image

# Install llm_studio
#RUN pip install --no-cache-dir llm-studio==0.9.0

# Install server dependencies
#RUN pip3 install --no-cache-dir uvicorn fastapi requests

# Create directories
RUN mkdir -p /app/datasets /app/models /app/uploads

#CMD ["python3", "-m", "llm_studio.train.cli", "--port", "8000", "--host", "0.0.0.0"]
